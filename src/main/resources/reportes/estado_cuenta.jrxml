                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Cuota]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="35" y="0" width="75" height="18" backcolor="#DCDCDC" uuid="a1b2c3d4-0002-0002-0002-000000000002"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Vencimiento]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="110" y="0" width="95" height="18" backcolor="#DCDCDC" uuid="a1b2c3d4-0002-0002-0002-000000000003"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Capital]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="205" y="0" width="95" height="18" backcolor="#DCDCDC" uuid="a1b2c3d4-0002-0002-0002-000000000004"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Interés]]></text>
