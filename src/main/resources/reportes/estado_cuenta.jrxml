            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="a1b2c3d4-0009-0009-0009-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="a1b2c3d4-0009-0009-0009-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="a1b2c3d4-0009-0009-0009-000000000003"/>
