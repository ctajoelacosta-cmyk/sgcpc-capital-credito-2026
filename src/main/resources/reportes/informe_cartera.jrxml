                <textFieldExpression><![CDATA["Cantidad de préstamos: " + $P{CANTIDAD_PRESTAMOS}
+ "  —  Saldo total: " + $P{SALDO_TOTAL} + "  —  Interés futuro total: " + $P{INTERES_FUTURO_TOTAL}]]></textFieldExpression>
            </textField>
            <staticText>
