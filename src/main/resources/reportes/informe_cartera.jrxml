                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Monto aprobado]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="350" y="0" width="100" height="24" backcolor="#DCDCDC" uuid="d4f6a8b0-0002-0002-0002-000000000004"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Saldo]]></text>
            </staticText>
            <!-- Ajuste de Joel (revisión del piloto L2-D): letra más chica que el resto (6.5),
                 pasa a 7, igual que las demás columnas; el ancho (210) ya alcanza. -->
            <staticText>
                <reportElement mode="Opaque" x="450" y="0" width="210" height="24" backcolor="#DCDCDC" uuid="d4f6a8b0-0002-0002-0002-000000000005"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Interés futuro programado (no exigible, Ley 6624)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="660" y="0" width="102" height="24" backcolor="#DCDCDC" uuid="d4f6a8b0-0002-0002-0002-000000000006"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
