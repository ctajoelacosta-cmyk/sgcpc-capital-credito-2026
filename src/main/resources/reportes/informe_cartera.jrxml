                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{montoAprobado}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="350" y="0" width="100" height="13" uuid="e5a7b9c1-0003-0003-0003-000000000004"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{capitalPendiente}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="450" y="0" width="210" height="13" uuid="e5a7b9c1-0003-0003-0003-000000000005"/>
