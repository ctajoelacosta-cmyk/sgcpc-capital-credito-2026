                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Subtotales por situación laboral:]]></text>
            </staticText>
            <!-- D-137: alto de una sola línea (14) en vez de 80 "por si acaso", con
                 isStretchWithOverflow + positionType Float, crece solo si el contenido real
                 tiene más de una línea; lo que antes dejaba un hueco en blanco enorme cuando
                 había pocas situaciones laborales en los resultados. -->
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="50" width="300" height="14" uuid="e4a1a1a1-0004-0004-0004-000000000004"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
