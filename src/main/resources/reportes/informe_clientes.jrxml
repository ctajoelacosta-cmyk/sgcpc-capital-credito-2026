<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Clientes (D-135/D-137, Bloque 7/E10, pedido de Joel): primer "informe" imprimible
     con filtros del sistema, distinto de un "reporte" (la consulta en pantalla de /reportes):
     este es el documento formal en PDF que refleja EXACTAMENTE los filtros elegidos en /clientes.
     Cabecera/filtros/pie son la convención común (ver infraestructura/GeneradorInformesPdf) que
     se repite igual en los próximos informes (Solicitudes, Préstamos, etc.); el detalle (columnas)
     es propio de Clientes. Todo ya viene formateado desde ServicioInformes, este archivo no
     calcula nada (REGLAS_DESARROLLO.md, sección 6).

     D-137 (Joel, prueba en el navegador): ninguna columna del detalle corta texto, C.I. más
     ancha (hasta 11 caracteres con puntos, ej. "800.000.003"), y las columnas de texto libre
     (Apellidos y Nombres, Ciudad, Situación laboral) con isStretchWithOverflow="true" (hacen
     salto de línea en vez de cortar un nombre/ciudad largo, ej. "Mariano Roque Alonso"). Mismo
     criterio para los próximos informes: ninguna columna de texto libre sin esta propiedad.
     Los bloques de "Subtotales por..." del resumen ahora arrancan con el alto de una sola línea
     (positionType="Float" + isStretchWithOverflow="true" crecen solo si hace falta) en vez de un
     alto fijo grande "por si acaso", eso era lo que dejaba un hueco en blanco enorme cuando el
     contenido real ocupaba menos. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_clientes" pageWidth="595" pageHeight="842" columnWidth="481"
              leftMargin="57" rightMargin="57" topMargin="40" bottomMargin="40"
              whenNoDataType="NoDataSection" uuid="b1d9a9f4-9d3a-4d63-8cf2-2a6a1e6d4a01">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_CLIENTES" class="java.lang.Integer"/>
    <parameter name="SUBTOTALES_SITUACION_LABORAL_TEXTO" class="java.lang.String"/>
    <parameter name="SUBTOTALES_CIUDAD_TEXTO" class="java.lang.String"/>

    <field name="cedula" class="java.lang.String"/>
    <field name="nombreCompleto" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="ciudad" class="java.lang.String"/>
    <field name="situacionLaboral" class="java.lang.String"/>
    <field name="fechaAlta" class="java.lang.String"/>
    <field name="prestamosActivos" class="java.lang.Integer"/>
    <field name="estado" class="java.lang.String"/>

    <title>
        <band height="150">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="481" height="40" uuid="4a1e9f21-2a3a-4a6a-8b1a-0a1a2a3a4a51"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="481" height="1" uuid="4a1e9f21-2a3a-4a6a-8b1a-0a1a2a3a4a52"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="481" height="20" uuid="4a1e9f21-2a3a-4a6a-8b1a-0a1a2a3a4a53"/>
