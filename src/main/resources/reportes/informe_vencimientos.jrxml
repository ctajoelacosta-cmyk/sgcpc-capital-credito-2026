                <textFieldExpression><![CDATA["Cuotas a vencer: " + $P{CANTIDAD_CUOTAS}
+ "  —  Capital " + $P{CAPITAL_TOTAL} + "  —  Interés " + $P{INTERES_TOTAL}
+ "  —  IVA " + $P{IVA_TOTAL} + "  —  Total " + $P{MONTO_TOTAL}]]></textFieldExpression>
