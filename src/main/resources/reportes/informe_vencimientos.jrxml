            <staticText>
                <reportElement mode="Opaque" x="340" y="0" width="60" height="24" backcolor="#DCDCDC" uuid="f6b8c0d2-0002-0002-0002-000000000004"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Cuota]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="400" y="0" width="75" height="24" backcolor="#DCDCDC" uuid="f6b8c0d2-0002-0002-0002-000000000005"/>
