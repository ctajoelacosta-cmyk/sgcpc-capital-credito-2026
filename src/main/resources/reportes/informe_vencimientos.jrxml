    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="b8d0e2f4-0004-0004-0004-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <!-- PA-10/Lote 2 (pedido de Joel, L2-D): "de" sin espacio final, total alineado a la
                 izquierda, mismo arreglo que el resto de los reportes. -->
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="b8d0e2f4-0004-0004-0004-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="b8d0e2f4-0004-0004-0004-000000000003"/>
                <textElement textAlignment="Left"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="60">
            <line>
                <reportElement x="0" y="0" width="762" height="1" uuid="c9d1e3f5-0005-0005-0005-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="762" height="16" uuid="c9d1e3f5-0005-0005-0005-000000000002"/>
