                <reportElement x="0" y="0" width="75" height="13" uuid="a7c9d1e3-0003-0003-0003-000000000001"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{identificadorOperacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="75" y="0" width="180" height="13" uuid="a7c9d1e3-0003-0003-0003-000000000002"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clienteNombre}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="255" y="0" width="85" height="13" uuid="a7c9d1e3-0003-0003-0003-000000000003"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clienteTelefono}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="0" width="60" height="13" uuid="a7c9d1e3-0003-0003-0003-000000000004"/>
                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroCuota} + "/" + $F{totalCuotas}]]></textFieldExpression>
