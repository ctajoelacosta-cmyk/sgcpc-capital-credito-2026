                <reportElement mode="Opaque" x="0" y="0" width="75" height="24" backcolor="#DCDCDC" uuid="b8d0e2f4-0002-0002-0002-000000000001"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
