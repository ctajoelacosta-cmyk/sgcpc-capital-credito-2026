                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[IVA 10%]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="665" y="0" width="97" height="24" backcolor="#DCDCDC" uuid="b8d0e2f4-0002-0002-0002-000000000008"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

