<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de IVA del mes (Bloque C tanda 2, pedido de Joel): mismo molde que los informes
     anteriores. Ocho columnas (factura/fecha/cliente/documento/exenta/gravada 10%/IVA 10%/
     total); las facturas ANULADAS del mes se listan marcadas (numeración completa para la DNIT)
     pero no entran en los totales del resumen final (REGLAS_DESARROLLO.md, sección 6: este archivo no
     calcula nada, los totales ya vienen armados de ServicioReportes.calcularTotalesIva). Celdas
     de encabezado y detalle con padding desde el arranque (Paso 1 del cierre del Bloque B). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_iva" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="f6b8c0d2-2c4e-4c7f-a80a-e47f9b1d3fb0">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_FACTURAS" class="java.lang.Integer"/>
    <parameter name="EXENTA_TOTAL" class="java.lang.String"/>
    <parameter name="GRAVADA_10_TOTAL" class="java.lang.String"/>
    <parameter name="IVA_10_TOTAL" class="java.lang.String"/>
    <parameter name="TOTAL_GENERAL" class="java.lang.String"/>

    <field name="numeroFactura" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="clienteNombre" class="java.lang.String"/>
    <field name="clienteDocumento" class="java.lang.String"/>
    <field name="totalExenta" class="java.lang.String"/>
    <field name="totalGravada10" class="java.lang.String"/>
    <field name="iva10" class="java.lang.String"/>
    <field name="total" class="java.lang.String"/>
    <field name="anulada" class="java.lang.Boolean"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="a7c9d1e3-0001-0001-0001-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="a7c9d1e3-0001-0001-0001-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="a7c9d1e3-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE IVA DEL MES]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="a7c9d1e3-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="28" uuid="a7c9d1e3-0001-0001-0001-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}
+ "  ·  Facturas (sin anuladas): " + $P{CANTIDAD_FACTURAS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
