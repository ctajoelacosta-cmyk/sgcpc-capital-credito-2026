<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Préstamos (B1, Bloque 7/E10, pedido de Joel): mismo molde que informe_clientes.jrxml
     (D-135/D-137): cabecera de empresa, "Filtros aplicados:", "Emitido por" y "Página N de M"
     son la convención común (ver infraestructura/GeneradorInformesPdf); el detalle (columnas) es
     propio de Préstamos. Hoja horizontal (pedido de Joel, para que entren las 9 columnas sin
     amontonarse). Todo ya viene formateado desde ServicioReportes/ServicioInformes, este archivo
     no calcula nada (REGLAS_DESARROLLO.md, sección 6). Mismo criterio D-137 que Clientes: Cliente con
     isStretchWithOverflow="true" para nombres largos. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
