<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Aprobaciones y rechazos (B3, Bloque 7/E10, pedido de Joel): mismo molde que
     informe_solicitudes.jrxml (B2): cabecera de empresa, "Filtros aplicados:", "Emitido por" y
     "Página N de M" son la convención común (ver infraestructura/GeneradorInformesPdf). Diez
     columnas (número/cliente/monto solicitado/monto aprobado/decisión/decidido por/fecha de
     envío/fecha de decisión/tiempo de respuesta/motivo), hoja horizontal; todo ya viene
     formateado desde ServicioReportes/ServicioInformes, este archivo no calcula nada (REGLAS_DESARROLLO.md,
     sección 6). Cliente/Decidido por/Motivo con isStretchWithOverflow="true" (D-137). -->
