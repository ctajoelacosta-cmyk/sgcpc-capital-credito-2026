<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Historial de cambios de parámetros (RF39, pantalla rediseñada, pedido de Joel),
     rediseñado con informe_morosidad.jrxml como modelo (el mejor resuelto de la familia
     "informes" del Bloque C): escudo a la izquierda del bloque de empresa, mismo patrón de
     título/"Filtros aplicados:"/"Emitido: ... Usuario: ...", pie con "Emitido por"/"Página N de
     M" (ese pie es idéntico en las otras 21 .jrxml de esta familia, confirmado con una búsqueda;
     se deja igual acá, corregirlo si hiciera falta queda para V9, no es un problema de este
     archivo en particular).
     4 columnas en vez de las 8 anteriores, igual que la pantalla: Fecha y hora | Parámetro
     (nombre ACTUAL + clave chica debajo) | Cambio (anterior → nuevo, nuevo en negrita, en UN
     solo textField con markup="styled", la primera vez que se usa en este sistema (estándar de
     JasperReports 6.20; los valores se escapan a mano, &amp;/&lt;/&gt; en ese orden, antes de
     armar el texto con el tag <b>, por si algún valor llegara a tener esos caracteres) más
     observación chica debajo si tiene texto | Usuario. Mismo orden (fecha y hora descendente) y
     mismas filas que la pantalla: vienen ya ordenadas/filtradas de
     ServicioReportes.listarHistorialParametros, este reporte no las reordena ni las filtra de
     nuevo. Resumen final "N cambios en el período · M parámetros modificados", splitType="Prevent"
     (mismo mecanismo que ya usaba este reporte y toda la familia; no hay nada más sofisticado en
     el resto del sistema para evitar que quede solo en una página).

     PILOTO de V9 (colores de marca en los PDF, pedido de Joel): los 4 colores de marca que usa
     este archivo quedan declarados en los 4 estilos con nombre de más abajo (TituloInforme,
     EncabezadoColumna, FilaAlterna, TotalFinal): un solo lugar para poder copiarlos después a
     los demás .jrxml sin repetir valores de color sueltos por el archivo. Ningún otro .jrxml del
     sistema se toca todavía: Joel aprueba este piloto antes de replicarlo. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_historial_parametros" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="a7b8c9d0-7007-7007-7007-700000000001">

    <!-- V9 (piloto, pedido de Joel): los 4 colores de marca, UN solo lugar. #0C325C (azul) y
         #1B9B6A (verde) son los mismos del logo que ya usa toda la pantalla (sgcpc-tema.css);
         #F4F6F8 es el gris muy claro para las filas alternadas. Todo lo demás queda negro sobre
         blanco (legible impreso en blanco y negro). -->
    <style name="TituloInforme" forecolor="#0C325C" fontName="DejaVu Sans" fontSize="13" isBold="true"/>
    <style name="EncabezadoColumna" forecolor="#FFFFFF" mode="Opaque" backcolor="#0C325C" fontName="DejaVu Sans" fontSize="7" isBold="true"/>
    <style name="FilaAlterna" mode="Opaque" backcolor="#F4F6F8"/>
    <style name="TotalFinal" forecolor="#0C325C" fontName="DejaVu Sans" fontSize="9" isBold="true"/>

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_TOTAL" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_PARAMETROS_DISTINTOS" class="java.lang.Integer"/>
    <parameter name="LOGO" class="byte[]"/>

    <field name="claveParametro" class="java.lang.String"/>
    <field name="parametro" class="java.lang.String"/>
    <field name="valorAnteriorMostrado" class="java.lang.String"/>
    <field name="valorNuevoMostrado" class="java.lang.String"/>
    <field name="modificadoPor" class="java.lang.String"/>
    <field name="fechaModificacion" class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>

    <title>
        <band height="112">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="42" height="42" uuid="a7b8c9d0-7007-7007-7007-700000000007"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField isStretchWithOverflow="true">
                <reportElement x="50" y="0" width="712" height="40" uuid="a7b8c9d0-7007-7007-7007-700000000002"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="a7b8c9d0-7007-7007-7007-700000000003"/>
                <graphicElement><pen lineColor="#1B9B6A"/></graphicElement>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" style="TituloInforme" uuid="a7b8c9d0-7007-7007-7007-700000000004"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[HISTORIAL DE CAMBIOS DE PARÁMETROS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="92" width="762" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000006"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}
+ "  ·  Cambios: " + $P{CANTIDAD_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement x="0" y="0" width="85" height="24" style="EncabezadoColumna" uuid="a7b8c9d0-7007-7007-7007-700000000011"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Fecha y hora]]></text>
            </staticText>
            <staticText>
                <reportElement x="85" y="0" width="260" height="24" style="EncabezadoColumna" uuid="a7b8c9d0-7007-7007-7007-700000000012"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Parámetro]]></text>
            </staticText>
            <staticText>
                <reportElement x="345" y="0" width="320" height="24" style="EncabezadoColumna" uuid="a7b8c9d0-7007-7007-7007-700000000013"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Cambio]]></text>
            </staticText>
            <staticText>
                <reportElement x="665" y="0" width="97" height="24" style="EncabezadoColumna" uuid="a7b8c9d0-7007-7007-7007-700000000014"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Usuario]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26">
            <!-- V9 (piloto): fila alternada, PRIMER elemento del detalle (queda detrás de los
                 demás, JasperReports dibuja en el orden en que aparecen). $V{REPORT_COUNT} es la
                 fila actual (empieza en 1); se sombrean las pares. Sin borde propio (pen a juego
                 con el relleno) para que no se vea un recuadro, solo el fondo. -->
            <rectangle>
                <reportElement x="0" y="0" width="762" height="26" style="FilaAlterna" uuid="a7b8c9d0-7007-7007-7007-700000000020">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineColor="#F4F6F8"/></graphicElement>
            </rectangle>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="85" height="26" uuid="a7b8c9d0-7007-7007-7007-700000000021"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{fechaModificacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="85" y="2" width="260" height="12" uuid="a7b8c9d0-7007-7007-7007-700000000022"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{parametro}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="85" y="14" width="260" height="10" uuid="a7b8c9d0-7007-7007-7007-700000000023"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="DejaVu Sans" size="6"/></textElement>
                <textFieldExpression><![CDATA[$F{claveParametro}]]></textFieldExpression>
            </textField>
            <!-- Cambio: UN solo campo, markup "styled", para que "anterior → nuevo" se lea junto
                 (antes eran dos textField separados y quedaba un hueco en el medio). Escapa
                 &/</> de los dos valores a mano, en ese orden (el & primero, para no romper los
                 &amp;/&lt;/&gt; que generan los otros dos reemplazos), antes de envolver el
                 nuevo en <b>. -->
            <textField isStretchWithOverflow="true">
                <reportElement x="345" y="2" width="320" height="12" uuid="a7b8c9d0-7007-7007-7007-700000000024"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Top" markup="styled"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{valorAnteriorMostrado}.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")
+ " → <b>"
+ $F{valorNuevoMostrado}.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")
+ "</b>"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="345" y="14" width="320" height="10" uuid="a7b8c9d0-7007-7007-7007-700000000026">
                    <printWhenExpression><![CDATA[!$F{observacion}.equals("—")]]></printWhenExpression>
                </reportElement>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="DejaVu Sans" size="6"/></textElement>
                <textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="665" y="0" width="97" height="26" uuid="a7b8c9d0-7007-7007-7007-700000000027"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{modificadoPor}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000031"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000032"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000033"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30" splitType="Prevent">
            <line>
                <reportElement x="0" y="0" width="762" height="1" uuid="a7b8c9d0-7007-7007-7007-700000000041"/>
            </line>
            <textField>
                <reportElement x="0" y="8" width="762" height="16" style="TotalFinal" uuid="a7b8c9d0-7007-7007-7007-700000000042"/>
                <textFieldExpression><![CDATA[$P{CANTIDAD_TOTAL} + " cambio" + ($P{CANTIDAD_TOTAL} == 1 ? "" : "s") + " en el período  ·  "
+ $P{CANTIDAD_PARAMETROS_DISTINTOS} + " parámetro" + ($P{CANTIDAD_PARAMETROS_DISTINTOS} == 1 ? "" : "s") + " modificado"
+ ($P{CANTIDAD_PARAMETROS_DISTINTOS} == 1 ? "" : "s")]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="112">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="42" height="42" uuid="a7b8c9d0-7007-7007-7007-700000000061"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField isStretchWithOverflow="true">
                <reportElement x="50" y="0" width="712" height="40" uuid="a7b8c9d0-7007-7007-7007-700000000051"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="a7b8c9d0-7007-7007-7007-700000000062"/>
                <graphicElement><pen lineColor="#1B9B6A"/></graphicElement>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" style="TituloInforme" uuid="a7b8c9d0-7007-7007-7007-700000000052"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[HISTORIAL DE CAMBIOS DE PARÁMETROS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="14" uuid="a7b8c9d0-7007-7007-7007-700000000063"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement positionType="Float" x="0" y="92" width="762" height="20" uuid="a7b8c9d0-7007-7007-7007-700000000053"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10" isBold="true" isItalic="true"/>
                </textElement>
                <text><![CDATA[No hay cambios de parámetros en ese rango.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
