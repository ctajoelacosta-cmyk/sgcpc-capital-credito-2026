<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Solicitudes (B2, Bloque 7/E10, pedido de Joel): mismo molde que informe_prestamos.jrxml
     (B1): cabecera de empresa, "Filtros aplicados:", "Emitido por" y "Página N de M" son la
     convención común (ver infraestructura/GeneradorInformesPdf); el detalle (columnas) es propio
     de Solicitudes. Hoja horizontal (8 columnas, Cliente/Oficial pueden ser largos). Todo ya
     viene formateado desde ServicioReportes/ServicioInformes, este archivo no calcula nada
     (REGLAS_DESARROLLO.md, sección 6). Cliente/Oficial con isStretchWithOverflow="true" (D-137). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_solicitudes" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="c1d9e2f6-2a5c-4b8d-ae3f-4c6d8e0f2a13">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_SOLICITUDES" class="java.lang.Integer"/>
    <parameter name="MONTO_TOTAL" class="java.lang.String"/>
    <parameter name="RESUMEN_POR_ESTADO_TEXTO" class="java.lang.String"/>

    <field name="numero" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
