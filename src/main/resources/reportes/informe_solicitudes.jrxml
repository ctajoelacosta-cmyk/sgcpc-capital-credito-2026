    <field name="clienteCedula" class="java.lang.String"/>
    <field name="montoSolicitadoFormateado" class="java.lang.String"/>
    <field name="plazoMeses" class="java.lang.Integer"/>
    <field name="estado" class="java.lang.String"/>
    <field name="oficialNombre" class="java.lang.String"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="d2e0f3a7-0001-0001-0001-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="d2e0f3a7-0001-0001-0001-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="d2e0f3a7-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE SOLICITUDES]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="d2e0f3a7-0001-0001-0001-000000000004"/>
