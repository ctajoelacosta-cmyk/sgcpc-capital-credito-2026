                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="28" uuid="d2e0f3a7-0001-0001-0001-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}
+ "  ·  Cantidad de solicitudes: " + $P{CANTIDAD_SOLICITUDES} + "  ·  Monto total: " + $P{MONTO_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </title>

