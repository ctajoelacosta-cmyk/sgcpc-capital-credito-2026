<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Resumen financiero (Bloque C tanda 2, pedido de Joel): "el PDF con el mismo
     contenido que la pantalla", un solo resumen, sin lista de filas, mismo patrón de un solo
     registro que informe_resumen_mensual.jrxml. Demanda por tramo de monto/plazo (las dos únicas
     listas del resumen) van como texto plano, mismo criterio que RESUMEN_POR_ESTADO_TEXTO de
     informe_prestamos.jrxml. Cada línea con positionType="Float" + isStretchWithOverflow="true"
     (ninguna posición Y fija ni ancho angosto): ninguna línea se recorta ni se superpone, sea cual
     sea el largo del texto (encontrado en la primera versión de este archivo, con dos columnas
     fijas de 370pt: "Ganancia bruta del período..." se cortaba antes de mostrar el monto). Hoja
     horizontal.

     Lote 2, L2-D (14-15/10/2026, pedido de Joel, autorizado): encabezado unificado vía subreporte
     común (encabezado_informe.jrxml), pie directo en pageFooter ("Emitido por" + "Página X de Y",
     PA-10), sin la línea Emitido/Usuario que repetía el pie. Sin "dato propio" de cantidad
     (resumen de un solo registro): "Filtros aplicados" queda solo en su renglón.

     PA-25: "Composición de lo cobrado en el período" y todo lo de abajo se superponía con "Saldo
     de préstamos en mora" (agregado después sin dejarle margen).

     PA-30 (15/10/2026, pedido de Joel): pageHeight vuelve a 595 (A4). El bloque grande de
     contenido pasa de "title" a "detail": un "title" (o "summary") de JasperReports debe entrar
     completo en una sola página declarada (no pagina por sí solo, a diferencia de "detail"); con
     el contenido real de este informe (varios tramos de demanda), 595 no alcanzaba. "title" ahora
     solo tiene el encabezado (subreporte) + "Filtros aplicados", siempre entra en la página 1;
     el resto del contenido vive en "detail", alimentado por el mismo JREmptyDataSource(1) de
     siempre (una sola "fila"; sin cambios en ServicioInformes.generarInformeResumenFinancieroPdf).
     JasperReports pagina "detail" solo, automáticamente, en el punto donde corresponda: nunca se
     corta a mitad de una línea. El pie ("Emitido por" + "Página X de Y") ya repetía en cada página
     por diseño (pageFooter), sin cambios ahí.

     PA-30, segunda vuelta (15/10/2026, pedido de Joel): la primera versión de "detail" iba en una
     sola columna de 762pt y, con los tramos de demanda reales, no entraba en una página (pasaba a
     una 2.ª página con una sola línea, y "Demanda por tramo de plazo" quedaba pegado al pie en la
     1.ª: rechazado). Ahora "detail" va en DOS columnas de 370pt (x=0 y x=392, separadas por
     22pt): izquierda con Créditos otorgados/en trámite, Aprobados sin desembolsar, Morosidad
     actual y Composición de lo cobrado (con Total cobrado y Ganancia bruta); derecha con Cartera,
     Demanda por tramo de monto y Demanda por tramo de plazo. positionType="Float" sigue haciendo
     que cada columna se acomode sola según el alto real de lo anterior EN ESA MISMA COLUMNA (el
     cálculo de Float de JasperReports es por superposición en X, así que una columna no empuja a
     la otra). Con esto el contenido real entra cómodo en una sola página, con margen antes del
     pie (si en el futuro crece mucho, con muchos tramos de demanda, "detail" sigue pudiendo
     paginar solo: no se perdió esa resistencia). DEMANDA_POR_MONTO_TEXTO/DEMANDA_POR_PLAZO_TEXTO
     son un solo textField con varias líneas unidas por "\n" (ServicioInformes.construirTextoTramos);
     sin <paragraph lineSpacing="Fixed" lineSpacingSize="14"/> esas líneas usan el interlineado
     por defecto de la fuente (más apretado que el resto del informe, hallazgo de Joel); con ese
     paragraph quedan al mismo espaciado de 14pt que las demás líneas del informe. Ninguna letra se
     achicó, los tamaños de fuente son los mismos de siempre. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_resumen_financiero" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" uuid="d0e2f4a6-5f7b-4f02-db3d-17ac2e4a6c93">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): LOGO (no lo tenía) y
         EMPRESA_TELEFONO/EMPRESA_WHATSAPP, para el subreporte común de encabezado
         (encabezado_informe.jrxml), mismo molde aprobado en morosidad/cobros. -->
    <parameter name="LOGO" class="byte[]"/>
    <parameter name="EMPRESA_TELEFONO" class="java.lang.String"/>
    <parameter name="EMPRESA_WHATSAPP" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="OTORGADOS_CANTIDAD" class="java.lang.Integer"/>
    <parameter name="OTORGADOS_MONTO" class="java.lang.String"/>
    <parameter name="EN_TRAMITE_CANTIDAD" class="java.lang.Integer"/>
    <parameter name="EN_TRAMITE_MONTO" class="java.lang.String"/>
    <parameter name="APROBADOS_SIN_DESEMBOLSAR_CANTIDAD" class="java.lang.Integer"/>
    <parameter name="APROBADOS_SIN_DESEMBOLSAR_MONTO" class="java.lang.String"/>
    <parameter name="MOROSIDAD_PORCENTAJE_CANTIDAD" class="java.lang.String"/>
    <parameter name="MOROSIDAD_PORCENTAJE_MONTO" class="java.lang.String"/>
    <parameter name="SALDO_PRESTAMOS_EN_MORA_PORCENTAJE" class="java.lang.String"/>
    <parameter name="COBRADO_CAPITAL" class="java.lang.String"/>
    <parameter name="COBRADO_INTERES" class="java.lang.String"/>
    <parameter name="COBRADO_MORATORIO" class="java.lang.String"/>
    <parameter name="COBRADO_PUNITORIO" class="java.lang.String"/>
    <parameter name="COBRADO_IVA" class="java.lang.String"/>
    <parameter name="COBRADO_TOTAL" class="java.lang.String"/>
    <parameter name="GANANCIA_DEL_PERIODO" class="java.lang.String"/>
    <parameter name="CARTERA_CAPITAL_PENDIENTE" class="java.lang.String"/>
    <parameter name="CARTERA_INTERES_FUTURO" class="java.lang.String"/>
    <parameter name="DEMANDA_POR_MONTO_TEXTO" class="java.lang.String"/>
    <parameter name="DEMANDA_POR_PLAZO_TEXTO" class="java.lang.String"/>

    <title>
        <band height="100">
            <!-- Lote 2, L2-D: encabezado (subreporte) + "Filtros aplicados". Siempre entra en la
                 página 1; el resto del contenido, que sí puede necesitar una 2.ª página, vive en
                 "detail" (ver más abajo). -->
            <subreport>
                <reportElement x="0" y="0" width="762" height="76"/>
                <subreportParameter name="LOGO"><subreportParameterExpression><![CDATA[$P{LOGO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RAZON_SOCIAL"><subreportParameterExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RUC"><subreportParameterExpression><![CDATA[$P{EMPRESA_RUC}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_DOMICILIO"><subreportParameterExpression><![CDATA[$P{EMPRESA_DOMICILIO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_TELEFONO"><subreportParameterExpression><![CDATA[$P{EMPRESA_TELEFONO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_WHATSAPP"><subreportParameterExpression><![CDATA[$P{EMPRESA_WHATSAPP}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="TITULO"><subreportParameterExpression><![CDATA["INFORME DE RESUMEN FINANCIERO"]]></subreportParameterExpression></subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression class="java.io.InputStream"><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("reportes/encabezado_informe.jasper")]]></subreportExpression>
            </subreport>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="82" width="762" height="16" uuid="e1f3a5b7-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <!-- PA-30, segunda vuelta (15/10/2026, pedido de Joel): dos columnas de 370pt (x=0 y
             x=392); ver el comentario de cabecera para el detalle. Gaps de 4pt entre secciones
             (2pt antes de "Total cobrado"), ninguna letra se achicó. -->
        <band height="300" splitType="Stretch">
            <!-- Columna izquierda (x=0, width=370). -->
            <staticText>
                <reportElement positionType="Float" x="0" y="0" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000006"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Créditos otorgados]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="16" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000007"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Cantidad: " + $P{OTORGADOS_CANTIDAD} + "   Monto: " + $P{OTORGADOS_MONTO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="34" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000008"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Créditos en trámite]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="50" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000009"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Cantidad: " + $P{EN_TRAMITE_CANTIDAD} + "   Monto: " + $P{EN_TRAMITE_MONTO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="68" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000010"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Aprobados sin desembolsar (foto de hoy)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="84" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000011"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Cantidad: " + $P{APROBADOS_SIN_DESEMBOLSAR_CANTIDAD} + "   Monto: " + $P{APROBADOS_SIN_DESEMBOLSAR_MONTO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="102" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000012"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Morosidad actual (a hoy)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="118" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000013"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Por cantidad de préstamos: " + $P{MOROSIDAD_PORCENTAJE_CANTIDAD}]]></textFieldExpression>
            </textField>
            <!-- 13/10/2026 (hallazgo de Joel): la etiqueta decía "Por monto de cartera", pero el
                 número es capital VENCIDO sobre la cartera; no el saldo total de los préstamos
                 en mora. Se corrige la etiqueta y se agrega abajo la otra mirada. -->
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="132" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000014"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Por capital vencido sobre la cartera: " + $P{MOROSIDAD_PORCENTAJE_MONTO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="146" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000030"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Saldo de préstamos en mora: " + $P{SALDO_PRESTAMOS_EN_MORA_PORCENTAJE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="164" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000015"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Composición de lo cobrado en el período]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="180" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000016"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Capital: " + $P{COBRADO_CAPITAL}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="194" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000017"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Interés (compensatorio): " + $P{COBRADO_INTERES}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="208" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000018"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Moratorio: " + $P{COBRADO_MORATORIO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="222" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000019"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Punitorio: " + $P{COBRADO_PUNITORIO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="236" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000020"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["IVA (para el Estado): " + $P{COBRADO_IVA}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="252" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000021"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total cobrado: " + $P{COBRADO_TOTAL}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="268" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000022"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Ganancia bruta del período (interés + moratorio + punitorio, sin IVA): " + $P{GANANCIA_DEL_PERIODO}]]></textFieldExpression>
            </textField>

            <!-- Columna derecha (x=392, width=370; 22pt de separación con la izquierda). -->
            <staticText>
                <reportElement positionType="Float" x="392" y="0" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000023"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Cartera (a hoy)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="392" y="16" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000024"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Capital pendiente: " + $P{CARTERA_CAPITAL_PENDIENTE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="392" y="30" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000025"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Interés futuro programado: " + $P{CARTERA_INTERES_FUTURO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="392" y="48" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000026"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Demanda por tramo de monto (solicitudes del período)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="392" y="64" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000027"/>
                <textElement><font fontName="DejaVu Sans" size="8"/><paragraph lineSpacing="Fixed" lineSpacingSize="14"/></textElement>
                <textFieldExpression><![CDATA[$P{DEMANDA_POR_MONTO_TEXTO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="392" y="82" width="370" height="16" uuid="e1f3a5b7-0002-0002-0002-000000000028"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Demanda por tramo de plazo (solicitudes del período)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="392" y="98" width="370" height="14" uuid="e1f3a5b7-0002-0002-0002-000000000029"/>
                <textElement><font fontName="DejaVu Sans" size="8"/><paragraph lineSpacing="Fixed" lineSpacingSize="14"/></textElement>
                <textFieldExpression><![CDATA[$P{DEMANDA_POR_PLAZO_TEXTO}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="f2a4b6c8-0002-0002-0002-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): "Página X de Y", PA-10 (sin
                 el espacio de más). -->
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="f2a4b6c8-0002-0002-0002-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="f2a4b6c8-0002-0002-0002-000000000003"/>
                <textElement textAlignment="Left"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
