    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="a7c9d1e3-0004-0004-0004-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="a7c9d1e3-0004-0004-0004-000000000002"/>
