                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Teléfono]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="315" y="0" width="85" height="24" backcolor="#DCDCDC" uuid="e5a7b9c1-0002-0002-0002-000000000004"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[C.I.]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="400" y="0" width="70" height="24" backcolor="#DCDCDC" uuid="e5a7b9c1-0002-0002-0002-00000000000a">
                </reportElement>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Días atraso]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="470" y="0" width="292" height="24" backcolor="#DCDCDC" uuid="e5a7b9c1-0002-0002-0002-00000000000b">
                </reportElement>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Monto exigible]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="13">
