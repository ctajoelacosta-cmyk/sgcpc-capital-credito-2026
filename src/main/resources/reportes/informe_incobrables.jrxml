            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="235" y="0" width="80" height="13" uuid="f6b8c0d2-0003-0003-0003-000000000003"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clienteTelefono}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="315" y="0" width="85" height="13" uuid="f6b8c0d2-0003-0003-0003-000000000004"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clienteCedula}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="70" height="13" uuid="f6b8c0d2-0003-0003-0003-00000000000a">
                </reportElement>
                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{diasAtraso}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="470" y="0" width="292" height="13" uuid="f6b8c0d2-0003-0003-0003-00000000000b">
                </reportElement>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{montoExigible}]]></textFieldExpression>
