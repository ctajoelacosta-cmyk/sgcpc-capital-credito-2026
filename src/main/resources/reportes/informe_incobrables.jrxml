                <reportElement x="0" y="0" width="762" height="1" uuid="b8d0e2f4-0005-0005-0005-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="500" height="16" uuid="b8d0e2f4-0005-0005-0005-000000000002"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total: " + $P{CANTIDAD_TOTAL} + " préstamo(s)  —  Saldo declarado incobrable: " + $P{SALDO_TOTAL}]]></textFieldExpression>
