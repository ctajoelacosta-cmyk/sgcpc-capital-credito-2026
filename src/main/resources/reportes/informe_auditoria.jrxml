         muestra la pantalla (FilaAuditoria.getUsuarioEscrito/getDireccionIpLegible/
         getNavegadorResumido). -->
    <field name="usuarioEscrito" class="java.lang.String"/>
    <field name="direccionIpLegible" class="java.lang.String"/>
    <field name="navegadorResumido" class="java.lang.String"/>

    <title>
