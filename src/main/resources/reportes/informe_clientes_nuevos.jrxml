<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Clientes nuevos (Bloque C tanda 3, pedido de Joel), mismo molde que los informes
     anteriores. Siete columnas (C.I./nombre/fecha de alta/teléfono/ciudad/situación laboral/
     préstamo); la columna "Préstamo" muestra el estado real del último préstamo del cliente
     (C-4 paso 1: antes decía "Sí"/"No" sobre ACTIVO/EN_MORA nada más, que confundía con un
     PENDIENTE_DESEMBOLSO o un FINALIZADO). Total y subtotales por ciudad van en el resumen final.
     Celdas de encabezado y detalle con padding desde el arranque (Paso 1 del cierre del Bloque B). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_clientes_nuevos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="d4e5f6a7-4004-4004-4004-400000000001">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_TOTAL" class="java.lang.Integer"/>
    <parameter name="POR_CIUDAD_TEXTO" class="java.lang.String"/>

    <field name="cedula" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="fechaRegistro" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="ciudad" class="java.lang.String"/>
    <field name="situacionLaboral" class="java.lang.String"/>
    <field name="estadoUltimoPrestamo" class="java.lang.String"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="d4e5f6a7-4004-4004-4004-400000000002"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="d4e5f6a7-4004-4004-4004-400000000003"/>
