                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE CLIENTES NUEVOS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="d4e5f6a7-4004-4004-4004-400000000005"/>
