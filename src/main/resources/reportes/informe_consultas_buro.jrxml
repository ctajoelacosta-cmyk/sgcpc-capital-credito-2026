<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Consultas al buró (C-4.4, pedido de Joel), ultimo informe del bloque C. Mismo
     molde que los informes anteriores: siete columnas (fecha/cliente/C.I./solicitud/resultado o
     clasificacion/quien consulto/autorizacion vigente en ese momento); total de consultas,
     cantidad por resultado y cantidad de clientes distintos en el resumen final, con
     splitType="Prevent" (mismo criterio que C-3b/C-4.1/C-4.2/C-4.3). Solo lectura: refleja lo que
     ya estaba guardado en consultas_crediticias, nunca cambia nada. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_consultas_buro" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="b8c9d0e1-8008-8008-8008-800000000001">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_TOTAL" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_CLIENTES_DISTINTOS" class="java.lang.Integer"/>
    <parameter name="POR_RESULTADO_TEXTO" class="java.lang.String"/>

    <field name="fecha" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="cedula" class="java.lang.String"/>
    <field name="solicitud" class="java.lang.String"/>
    <field name="resultado" class="java.lang.String"/>
    <field name="quienConsulto" class="java.lang.String"/>
    <field name="autorizacionVigente" class="java.lang.String"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="b8c9d0e1-8008-8008-8008-800000000002"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="b8c9d0e1-8008-8008-8008-800000000003"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="b8c9d0e1-8008-8008-8008-800000000004"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[CONSULTAS AL BURÓ]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="b8c9d0e1-8008-8008-8008-800000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="28" uuid="b8c9d0e1-8008-8008-8008-800000000006"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}
+ "  ·  Consultas: " + $P{CANTIDAD_TOTAL} + "  ·  Clientes distintos: " + $P{CANTIDAD_CLIENTES_DISTINTOS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

