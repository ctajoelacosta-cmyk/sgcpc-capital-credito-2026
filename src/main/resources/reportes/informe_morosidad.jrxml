                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{tramo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="545" y="0" width="90" height="13" uuid="d4f6a8b0-0003-0003-0003-00000000000c">
                </reportElement>
                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{cuotasVencidas}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="635" y="0" width="127" height="13" uuid="d4f6a8b0-0003-0003-0003-00000000000d">
                </reportElement>
                <box leftPadding="3" rightPadding="3"/>
