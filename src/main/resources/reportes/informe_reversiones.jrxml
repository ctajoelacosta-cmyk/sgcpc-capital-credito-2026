<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Reversiones (Bloque C tanda 3, pedido de Joel), mismo molde que los informes
     anteriores. Diez columnas (fecha/recibo revertido/operación/cliente/monto/motivo/estado/quién
     solicitó/quién autorizó/nota de anulación); el total de montos revertidos (solo AUTORIZADA)
     va en el resumen final. Celdas de encabezado y detalle con padding desde el arranque (Paso 1
     del cierre del Bloque B). -->
