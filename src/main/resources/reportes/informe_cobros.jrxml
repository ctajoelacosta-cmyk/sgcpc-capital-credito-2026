<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Cobros (B4, Bloque 7/E10, pedido de Joel): mismo molde que informe_aprobaciones.jrxml
     (B3): cabecera de empresa, "Filtros aplicados:", "Emitido por" y "Página N de M". Trece
     columnas (fecha/recibo/cliente/C.I./operación/tipo/capital/interés/moratorio/punitorio/IVA/
     total/cajera), hoja horizontal; todo ya viene formateado desde ServicioReportes/
     ServicioInformes, este archivo no calcula nada (REGLAS_DESARROLLO.md, sección 6). Un cobro revertido
     llega con "— Revertido" ya incluido en el campo tipo (no se excluye de la lista, solo de los
     totales: eso ya lo hace calcularTotalesCobros antes de armar los parámetros). Cliente/Cajera
     con isStretchWithOverflow="true" (D-137). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_cobros" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="b4c6d8e0-4a6b-4c8d-ae2f-6b8d0a2c4e36">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): LOGO (no lo tenía) y
         EMPRESA_TELEFONO/EMPRESA_WHATSAPP, para el subreporte común de encabezado
         (encabezado_informe.jrxml). -->
    <parameter name="LOGO" class="byte[]"/>
    <parameter name="EMPRESA_TELEFONO" class="java.lang.String"/>
    <parameter name="EMPRESA_WHATSAPP" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_COBROS" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_REVERTIDOS" class="java.lang.Integer"/>
    <parameter name="CAPITAL_TOTAL" class="java.lang.String"/>
    <parameter name="INTERES_TOTAL" class="java.lang.String"/>
    <parameter name="MORATORIO_TOTAL" class="java.lang.String"/>
    <parameter name="PUNITORIO_TOTAL" class="java.lang.String"/>
    <parameter name="IVA_TOTAL" class="java.lang.String"/>
    <parameter name="TOTAL_GENERAL" class="java.lang.String"/>

    <field name="fecha" class="java.lang.String"/>
    <field name="recibo" class="java.lang.String"/>
    <field name="clienteNombre" class="java.lang.String"/>
    <field name="clienteCedula" class="java.lang.String"/>
    <field name="operacion" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="capitalFormateado" class="java.lang.String"/>
    <field name="interesFormateado" class="java.lang.String"/>
    <field name="moratorioFormateado" class="java.lang.String"/>
    <field name="punitorioFormateado" class="java.lang.String"/>
    <field name="ivaFormateado" class="java.lang.String"/>
    <field name="totalFormateado" class="java.lang.String"/>
    <field name="cajeraNombre" class="java.lang.String"/>

    <title>
        <band height="112">
            <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): encabezado unificado vía
                 subreporte común (encabezado_informe.jrxml), ver ese archivo. El pie queda
                 directo en pageFooter, más abajo (no dentro del subreporte: el total de páginas
                 no se resuelve bien si se mete dentro de un subreporte invocado por página).
                 Ajuste (pedido de Joel, revisión del piloto): la línea "Emitido/Usuario" repetía
                 el pie, sacada; "Cantidad de cobros: N" pasa a la misma línea de "Filtros
                 aplicados". Un solo renglón antes de la tabla, sin hueco grande. -->
            <subreport>
                <reportElement x="0" y="0" width="762" height="76"/>
                <subreportParameter name="LOGO"><subreportParameterExpression><![CDATA[$P{LOGO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RAZON_SOCIAL"><subreportParameterExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RUC"><subreportParameterExpression><![CDATA[$P{EMPRESA_RUC}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_DOMICILIO"><subreportParameterExpression><![CDATA[$P{EMPRESA_DOMICILIO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_TELEFONO"><subreportParameterExpression><![CDATA[$P{EMPRESA_TELEFONO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_WHATSAPP"><subreportParameterExpression><![CDATA[$P{EMPRESA_WHATSAPP}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="TITULO"><subreportParameterExpression><![CDATA["INFORME DE COBROS"]]></subreportParameterExpression></subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression class="java.io.InputStream"><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("reportes/encabezado_informe.jasper")]]></subreportExpression>
            </subreport>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="82" width="762" height="16" uuid="c5d7e9f1-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS} + "  ·  Cantidad de cobros: " + $P{CANTIDAD_COBROS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <!-- Ajuste de Joel (revisión del piloto L2-D): "Cliente" y "Tipo" eran angostas (el
                 texto se cortaba en 2 renglones, p. ej. nombres largos o "Pago parcial con
                 promesa"); se les da más ancho, sacado de las columnas de monto y "Cajera" (que
                 ya sobraban). La letra ya era uniforme en toda la fila (6.5 header / 6 detalle),
                 eso no cambia. -->
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="46" height="24" backcolor="#DCDCDC" uuid="d6e8f0a2-0002-0002-0002-000000000001"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
