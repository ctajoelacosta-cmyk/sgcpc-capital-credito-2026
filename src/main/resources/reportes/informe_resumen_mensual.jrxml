<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Resumen mensual (Bloque C tanda 2, pedido de Joel): "el PDF con el mismo
     contenido que la pantalla", un solo resumen, sin lista de filas, mismo patrón de un solo
     registro que los comprobantes de un solo documento (constancia_devolucion.jrxml: todo en el
     título, con JREmptyDataSource(1) como fuente de datos). Una sola columna, cada línea con
     positionType="Float" + isStretchWithOverflow="true" (ninguna posición Y fija): ninguna línea
     se recorta ni se superpone, sea cual sea el largo del texto (encontrado en la primera versión
     de este archivo, con columnas fijas de 370pt: "Ganancia del mes..." se cortaba justo antes de
     "Gs." porque el box de una sola línea no alcanzaba para el renglón completo). Hoja horizontal. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_resumen_mensual" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" uuid="b8d0e2f4-4e6a-4e91-ca2c-069b1d3f5b82">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): LOGO (no lo tenía) y
         EMPRESA_TELEFONO/EMPRESA_WHATSAPP, para el subreporte común de encabezado
         (encabezado_informe.jrxml), mismo molde aprobado en morosidad/cobros. -->
    <parameter name="LOGO" class="byte[]"/>
    <parameter name="EMPRESA_TELEFONO" class="java.lang.String"/>
    <parameter name="EMPRESA_WHATSAPP" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="PRESTAMOS_OTORGADOS_CANTIDAD" class="java.lang.Integer"/>
    <parameter name="PRESTAMOS_OTORGADOS_MONTO" class="java.lang.String"/>
    <parameter name="MOROSIDAD_PORCENTAJE_CANTIDAD" class="java.lang.String"/>
    <parameter name="MOROSIDAD_PORCENTAJE_MONTO" class="java.lang.String"/>
    <parameter name="SALDO_PRESTAMOS_EN_MORA_PORCENTAJE" class="java.lang.String"/>
    <parameter name="COBRADO_CAPITAL" class="java.lang.String"/>
    <parameter name="COBRADO_INTERES" class="java.lang.String"/>
    <parameter name="COBRADO_MORATORIO" class="java.lang.String"/>
    <parameter name="COBRADO_PUNITORIO" class="java.lang.String"/>
    <parameter name="COBRADO_IVA" class="java.lang.String"/>
    <parameter name="COBRADO_TOTAL" class="java.lang.String"/>
    <parameter name="GANANCIA_DEL_MES" class="java.lang.String"/>

    <title>
        <band height="420">
            <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): mismo molde aprobado en
                 morosidad/cobros, subreporte común de encabezado (encabezado_informe.jrxml),
                 pie directo en pageFooter (agregado "Página X de Y", no lo tenía), sin la línea
                 Emitido/Usuario que repetía el pie. Este informe no tiene un "dato propio" de
                 cantidad (es un resumen de un solo registro), así que "Filtros aplicados" queda
                 solo en su renglón. -->
            <subreport>
                <reportElement x="0" y="0" width="762" height="76"/>
                <subreportParameter name="LOGO"><subreportParameterExpression><![CDATA[$P{LOGO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RAZON_SOCIAL"><subreportParameterExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_RUC"><subreportParameterExpression><![CDATA[$P{EMPRESA_RUC}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_DOMICILIO"><subreportParameterExpression><![CDATA[$P{EMPRESA_DOMICILIO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_TELEFONO"><subreportParameterExpression><![CDATA[$P{EMPRESA_TELEFONO}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="EMPRESA_WHATSAPP"><subreportParameterExpression><![CDATA[$P{EMPRESA_WHATSAPP}]]></subreportParameterExpression></subreportParameter>
                <subreportParameter name="TITULO"><subreportParameterExpression><![CDATA["INFORME DE RESUMEN MENSUAL"]]></subreportParameterExpression></subreportParameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
                <subreportExpression class="java.io.InputStream"><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("reportes/encabezado_informe.jasper")]]></subreportExpression>
            </subreport>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="82" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="120" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000006"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Préstamos otorgados]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="138" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000007"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Cantidad: " + $P{PRESTAMOS_OTORGADOS_CANTIDAD} + "   Monto: " + $P{PRESTAMOS_OTORGADOS_MONTO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" x="0" y="160" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000008"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Morosidad actual (a hoy)]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="178" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000009"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Por cantidad de préstamos: " + $P{MOROSIDAD_PORCENTAJE_CANTIDAD}]]></textFieldExpression>
            </textField>
            <!-- 13/10/2026 (hallazgo de Joel): la etiqueta decía "Por monto de cartera", pero el
                 número es capital VENCIDO sobre la cartera; no el saldo total de los préstamos
                 en mora. Se corrige la etiqueta y se agrega abajo la otra mirada. -->
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="194" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000010"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Por capital vencido sobre la cartera: " + $P{MOROSIDAD_PORCENTAJE_MONTO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="210" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000019"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Saldo de préstamos en mora: " + $P{SALDO_PRESTAMOS_EN_MORA_PORCENTAJE}]]></textFieldExpression>
            </textField>

            <!-- PA-25 (14/10/2026, pedido de Joel, L2-D): "Composición de lo cobrado" y todo lo
                 de abajo corrido +10. La línea "Saldo de préstamos en mora" (y=210, termina en
                 224) se agregó después sin dejarle margen a este título (estaba en y=222, se
                 superponían 2pt). -->
            <staticText>
                <reportElement positionType="Float" x="0" y="232" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000011"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
                <text><![CDATA[Composición de lo cobrado]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="250" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000012"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Capital: " + $P{COBRADO_CAPITAL}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="266" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000013"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Interés (compensatorio): " + $P{COBRADO_INTERES}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="282" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000014"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Moratorio: " + $P{COBRADO_MORATORIO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="298" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000015"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Punitorio: " + $P{COBRADO_PUNITORIO}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="314" width="762" height="14" uuid="c9d1e3f5-0001-0001-0001-000000000016"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["IVA: " + $P{COBRADO_IVA}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="332" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000017"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total cobrado: " + $P{COBRADO_TOTAL}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="350" width="762" height="16" uuid="c9d1e3f5-0001-0001-0001-000000000018"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Ganancia del mes (interés + moratorio + punitorio, sin IVA): " + $P{GANANCIA_DEL_MES}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="d0e2f4a6-0002-0002-0002-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <!-- Lote 2, L2-D (14/10/2026, pedido de Joel, autorizado): "Página X de Y", no lo
                 tenía, mismo arreglo de PA-10 que el resto. -->
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="d0e2f4a6-0002-0002-0002-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="d0e2f4a6-0002-0002-0002-000000000003"/>
                <textElement textAlignment="Left"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
