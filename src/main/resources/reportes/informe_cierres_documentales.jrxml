<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Cierres documentales (Bloque C tanda 2, ampliado E-12 a pedido de Joel): ahora
     lista TODOS los préstamos cancelados en el período, no solo los que ya tienen el pagaré
     devuelto. Ocho columnas (operación/cliente/fecha de cancelación/constancia de cancelación/
     estado del pagaré/constancia de devolución/fecha de devolución/quién entregó); "Pendiente de
     devolución" resaltado en ámbar (#a15c00, mismo criterio que A3d: necesita atención, no es un
     error) vía un estilo condicional, el único lugar de este informe donde el resaltado SÍ se
     puede llevar al PDF (en Caja, A3d, el resaltado se quedó solo en pantalla). Los totales
     (cancelados, devueltos y pendientes) van en el resumen final. Celdas de encabezado y detalle
     con padding desde el arranque (Paso 1 del cierre del Bloque B). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_cierres_documentales" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="f2a4b6c8-6a8c-4a13-ec4e-28bd3f5b7da4">

    <style name="estiloEstadoPagare" fontName="DejaVu Sans" fontSize="7">
        <conditionalStyle>
            <conditionExpression><![CDATA[new Boolean(!$F{pagareDevuelto}.booleanValue())]]></conditionExpression>
            <style forecolor="#A15C00" isBold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_CANCELADOS" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_DEVUELTOS" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_PENDIENTES" class="java.lang.Integer"/>

    <field name="identificadorOperacion" class="java.lang.String"/>
    <field name="clienteNombre" class="java.lang.String"/>
    <field name="fechaCancelacion" class="java.lang.String"/>
    <field name="numeroConstanciaCancelacion" class="java.lang.String"/>
    <field name="estadoPagare" class="java.lang.String"/>
    <field name="pagareDevuelto" class="java.lang.Boolean"/>
    <field name="numeroConstanciaDevolucion" class="java.lang.String"/>
    <field name="fechaDevolucionPagare" class="java.lang.String"/>
    <field name="entregadoPorNombre" class="java.lang.String"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="a3b5c7d9-0001-0001-0001-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="a3b5c7d9-0001-0001-0001-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="a3b5c7d9-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE CIERRES DOCUMENTALES]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="a3b5c7d9-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="28" uuid="a3b5c7d9-0001-0001-0001-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}
+ "  ·  Cancelados: " + $P{CANTIDAD_CANCELADOS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="70" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000001"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Operación]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="70" y="0" width="140" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000002"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="210" y="0" width="65" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000003"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[Fecha de cancelación]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="275" y="0" width="85" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000004"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[Constancia de cancelación]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="360" y="0" width="110" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000005"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Estado del pagaré]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="470" y="0" width="85" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000006"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[Constancia de devolución]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="555" y="0" width="65" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000007"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
                <text><![CDATA[Fecha de devolución]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="620" y="0" width="142" height="24" backcolor="#DCDCDC" uuid="b4c6d8e0-0002-0002-0002-000000000008"/>
                <box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Quién entregó]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="13">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="70" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000001"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{identificadorOperacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="70" y="0" width="140" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000002"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clienteNombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="210" y="0" width="65" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000003"/>
                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{fechaCancelacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="275" y="0" width="85" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000004"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroConstanciaCancelacion}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="360" y="0" width="110" height="13" style="estiloEstadoPagare" uuid="c5d7e9f1-0003-0003-0003-000000000005"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{estadoPagare}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="470" y="0" width="85" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000006"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroConstanciaDevolucion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="555" y="0" width="65" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000007"/>
                <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{fechaDevolucionPagare}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="620" y="0" width="142" height="13" uuid="c5d7e9f1-0003-0003-0003-000000000008"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{entregadoPorNombre}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="d6e8f0a2-0004-0004-0004-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="d6e8f0a2-0004-0004-0004-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="d6e8f0a2-0004-0004-0004-000000000003"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="762" height="1" uuid="e7f9a1b3-0005-0005-0005-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="762" height="16" uuid="e7f9a1b3-0005-0005-0005-000000000002"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total: " + $P{CANTIDAD_CANCELADOS} + " cancelado(s)  —  " + $P{CANTIDAD_DEVUELTOS}
+ " devuelto(s)  —  " + $P{CANTIDAD_PENDIENTES} + " pendiente(s) de devolución"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="220">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="f8a0b2c4-0006-0006-0006-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="f8a0b2c4-0006-0006-0006-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="f8a0b2c4-0006-0006-0006-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE CIERRES DOCUMENTALES]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="f8a0b2c4-0006-0006-0006-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="14" uuid="f8a0b2c4-0006-0006-0006-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement positionType="Float" x="0" y="134" width="762" height="20" uuid="f8a0b2c4-0006-0006-0006-000000000006"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10" isBold="true" isItalic="true"/>
                </textElement>
                <text><![CDATA[No hay préstamos cancelados en ese rango (con ese filtro).]]></text>
            </staticText>
        </band>
