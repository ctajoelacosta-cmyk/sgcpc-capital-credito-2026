<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Caja (B5, Bloque 7/E10, pedido de Joel): mismo molde que informe_desembolsos.jrxml:
     cabecera de empresa, "Filtros aplicados:", "Emitido por" y "Página N de M". Ocho columnas
     (cajera/apertura/cierre/fondo inicial/saldo teórico/efectivo contado/diferencia/revisada),
     hoja horizontal por consistencia con los otros informes de esta tanda; todo ya viene
     formateado desde ServicioReportes/ServicioInformes (la diferencia, con el mismo "Sobra/Falta"
     de ServicioCaja.formatearDiferenciaArqueo, A3d), este archivo no calcula nada (REGLAS_DESARROLLO.md,
     sección 6). Cajera con isStretchWithOverflow="true" (D-137). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
