    <field name="efectivoContadoFormateado" class="java.lang.String"/>
    <field name="diferenciaFormateada" class="java.lang.String"/>
    <field name="revisada" class="java.lang.Boolean"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="e9f1a3b5-0001-0001-0001-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="e9f1a3b5-0001-0001-0001-000000000002"/>
            </line>
            <staticText>
