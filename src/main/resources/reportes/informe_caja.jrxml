    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_SESIONES" class="java.lang.Integer"/>
    <parameter name="SUMA_SOBRANTES" class="java.lang.String"/>
    <parameter name="SUMA_FALTANTES" class="java.lang.String"/>

    <field name="cajeraNombre" class="java.lang.String"/>
