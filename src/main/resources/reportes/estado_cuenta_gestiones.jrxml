<?xml version="1.0" encoding="UTF-8"?>
<!-- Subreporte del Estado de cuenta (RF34): "Gestiones de cobranza", embebido en el summary de
     estado_cuenta.jrxml, después del subreporte de Historial (Float). Sin título ni encabezado
     de empresa propios. Misma fila que /reportes/gestiones (FilaGestionReporte), reusada sin un
     DTO nuevo. -->
