<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Proyección de fondos (Bloque C tanda 1, pedido de Joel): mismo molde que
     informe_morosidad/informe_cartera/informe_incobrables/informe_vencimientos.jrxml de arriba.
     Cinco columnas (horizonte/ingresos esperados/egresos comprometidos/posibles egresos en
     trámite/flujo neto); el resumen final repite el horizonte de 90 días como "Total a 90 días",
     que NO es una suma de los tres horizontes (D-128: son acumulados, 90 días ya incluye 60 y 30
     días, sumarlos contaría dos veces el mismo cobro: ver ServicioInformes.
     generarInformeProyeccionFondosPdf). Celdas de encabezado y detalle con padding desde el
     arranque (Paso 1 del cierre del Bloque B). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_proyeccion_fondos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="e5a7b9c1-1b3d-4b6e-f79f-d36e8a0c2eaf">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="INGRESOS_A_90_DIAS" class="java.lang.String"/>
    <parameter name="EGRESOS_A_90_DIAS" class="java.lang.String"/>
    <parameter name="FLUJO_NETO_A_90_DIAS" class="java.lang.String"/>

    <field name="horizonteDias" class="java.lang.Integer"/>
    <field name="ingresosEsperados" class="java.lang.String"/>
    <field name="egresosComprometidos" class="java.lang.String"/>
    <field name="posiblesEgresosEnTramite" class="java.lang.String"/>
    <field name="flujoNeto" class="java.lang.String"/>
    <field name="flujoNetoNegativo" class="java.lang.Boolean"/>

    <title>
        <band height="140">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="f6b8c0d2-0001-0001-0001-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="f6b8c0d2-0001-0001-0001-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="f6b8c0d2-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE PROYECCIÓN DE FONDOS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="f6b8c0d2-0001-0001-0001-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="28" uuid="f6b8c0d2-0001-0001-0001-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="100" height="24" backcolor="#DCDCDC" uuid="a7c9d1e3-0002-0002-0002-000000000001"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Horizonte]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="100" y="0" width="150" height="24" backcolor="#DCDCDC" uuid="a7c9d1e3-0002-0002-0002-000000000002"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Ingresos esperados (cobros)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="250" y="0" width="150" height="24" backcolor="#DCDCDC" uuid="a7c9d1e3-0002-0002-0002-000000000003"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Egresos comprometidos (a desembolsar)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="400" y="0" width="180" height="24" backcolor="#DCDCDC" uuid="a7c9d1e3-0002-0002-0002-000000000004"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Posibles egresos (solicitudes en trámite)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="580" y="0" width="182" height="24" backcolor="#DCDCDC" uuid="a7c9d1e3-0002-0002-0002-000000000005"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
                <text><![CDATA[Flujo neto proyectado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="0" y="0" width="100" height="24" uuid="b8d0e2f4-0003-0003-0003-000000000001"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Left" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["A " + $F{horizonteDias} + " días"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="100" y="0" width="150" height="24" uuid="b8d0e2f4-0003-0003-0003-000000000002"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{ingresosEsperados}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="250" y="0" width="150" height="24" uuid="b8d0e2f4-0003-0003-0003-000000000003"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{egresosComprometidos}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="400" y="0" width="180" height="24" uuid="b8d0e2f4-0003-0003-0003-000000000004"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{posiblesEgresosEnTramite}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="580" y="0" width="182" height="24" uuid="b8d0e2f4-0003-0003-0003-000000000005"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{flujoNeto}
+ ($F{flujoNetoNegativo} ? ("\nNecesidad de fondos: " + $F{flujoNeto}.replace("-", "")) : "")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="500" height="14" uuid="c9d1e3f5-0004-0004-0004-000000000001"/>
                <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO_EMISOR} + " — " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="148" height="14" uuid="c9d1e3f5-0004-0004-0004-000000000002"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="748" y="0" width="14" height="14" uuid="c9d1e3f5-0004-0004-0004-000000000003"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="80">
            <line>
                <reportElement x="0" y="0" width="762" height="1" uuid="d0e2f4a6-0005-0005-0005-000000000001"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="762" height="16" uuid="d0e2f4a6-0005-0005-0005-000000000002"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total a 90 días (acumulado, incluye 30 y 60 días): ingresos " + $P{INGRESOS_A_90_DIAS}
+ "  —  egresos comprometidos " + $P{EGRESOS_A_90_DIAS} + "  —  flujo neto " + $P{FLUJO_NETO_A_90_DIAS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement positionType="Float" x="0" y="34" width="762" height="28" uuid="d0e2f4a6-0005-0005-0005-000000000003"/>
                <textElement><font fontName="DejaVu Sans" size="7" isItalic="true"/></textElement>
                <text><![CDATA[Los horizontes son acumulados (60 días incluye los cobros de 30, 90 incluye los de 60): no se suman entre sí, el de 90 días ya es el total.]]></text>
            </staticText>
        </band>
    </summary>

    <noData>
        <band height="220">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="e1f3a5b7-0006-0006-0006-000000000001"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="e1f3a5b7-0006-0006-0006-000000000002"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="e1f3a5b7-0006-0006-0006-000000000003"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[INFORME DE PROYECCIÓN DE FONDOS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="76" width="762" height="28" uuid="e1f3a5b7-0006-0006-0006-000000000004"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Filtros aplicados: " + $P{FILTROS_APLICADOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="108" width="762" height="14" uuid="e1f3a5b7-0006-0006-0006-000000000005"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION} + "  ·  Usuario: " + $P{USUARIO_EMISOR}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement positionType="Float" x="0" y="134" width="762" height="20" uuid="e1f3a5b7-0006-0006-0006-000000000006"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10" isBold="true" isItalic="true"/>
                </textElement>
                <text><![CDATA[No se pudo calcular la proyección.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
