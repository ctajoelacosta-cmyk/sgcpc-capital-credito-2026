<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Gestiones de cobranza (Bloque C tanda 3, pedido de Joel; corregido en C-3b): fecha,
     operación, contactado, tipo, resultado, promesa (fecha y monto combinados), si se cumplió y
     quién registró. Totales: cantidad por tipo, promesas hechas, cumplidas, vencidas sin cumplir y
     pendientes (aún no vencen). El resumen va en un bloque summary con splitType="Prevent" (C-3b:
     antes, con muchas filas, el bloque de totales podía quedar partido entre la última página de
     detalle y una página siguiente casi vacía; Prevent fuerza a que entre entero en la página
     anterior o arranque entero en una nueva, nunca dividido). Celdas de encabezado y detalle con
     padding desde el arranque (Paso 1 del cierre del Bloque B). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_gestiones" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="a1b2c3d4-1001-1001-1001-100000000001">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="EMPRESA_DOMICILIO" class="java.lang.String"/>
    <parameter name="USUARIO_EMISOR" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>
    <parameter name="FILTROS_APLICADOS" class="java.lang.String"/>
    <parameter name="CANTIDAD_TOTAL" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_PROMESAS_HECHAS" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_CUMPLIDAS" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_VENCIDAS_SIN_CUMPLIR" class="java.lang.Integer"/>
    <parameter name="CANTIDAD_PENDIENTES" class="java.lang.Integer"/>
    <parameter name="POR_TIPO_TEXTO" class="java.lang.String"/>

    <field name="fechaHora" class="java.lang.String"/>
    <field name="identificadorOperacion" class="java.lang.String"/>
    <field name="contactadoNombre" class="java.lang.String"/>
    <field name="tipoEtiqueta" class="java.lang.String"/>
    <field name="resultado" class="java.lang.String"/>
    <field name="promesaTexto" class="java.lang.String"/>
    <field name="cumplidaTexto" class="java.lang.String"/>
    <field name="registradoPorNombre" class="java.lang.String"/>

    <title>
        <band height="150">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="762" height="40" uuid="a1b2c3d4-1001-1001-1001-100000000002"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPRESA_RAZON_SOCIAL}
+ "\nRUC " + $P{EMPRESA_RUC}
+ "\n" + $P{EMPRESA_DOMICILIO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="46" width="762" height="1" uuid="a1b2c3d4-1001-1001-1001-100000000003"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="52" width="762" height="20" uuid="a1b2c3d4-1001-1001-1001-100000000004"/>
