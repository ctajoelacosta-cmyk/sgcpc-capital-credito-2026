<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de Desembolsos (B4, Bloque 7/E10, pedido de Joel): mismo molde que informe_cobros.jrxml
     de arriba: cabecera de empresa, "Filtros aplicados:", "Emitido por" y "Página N de M". Siete
     columnas (fecha/comprobante/cliente/C.I./operación/monto/desembolsado por), hoja horizontal
     por consistencia con los otros tres informes de esta tanda; todo ya viene formateado desde
     ServicioReportes/ServicioInformes, este archivo no calcula nada (REGLAS_DESARROLLO.md, sección 6).
     Cliente/Desembolsado por con isStretchWithOverflow="true" (D-137). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="informe_desembolsos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="762"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection" uuid="c5d7e9f1-5b7c-4d9e-af3a-7c9e1b3d5f47">

    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
