    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Punto 1c: nunca la pantalla tecnica de Tomcat (stacktrace, nombre de
         clases, version del servidor) - Doc. 10 §10.18. El error real va solo
         al log (Tomcat lo hace automaticamente para toda excepcion no atrapada). -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/vistas/error-403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error-404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error-500.jsp</location>
    </error-page>
    <!-- Portabilidad (pedido de Joel): entrada MÁS específica que la de Throwable de abajo (el
         contenedor elige la coincidencia de tipo más cercana, no la que aparece primero en este
         archivo); sin conexión a la base es un problema de configuración del servidor, no un
         error cualquiera. Ver ErrorConexionBD / FabricaConexionBD / error-bd.jsp. -->
    <error-page>
        <exception-type>py.com.capitalcredito.sgcpc.infraestructura.ErrorConexionBD</exception-type>
        <location>/WEB-INF/vistas/error-bd.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error-500.jsp</location>
    </error-page>

